# Copy to .env and adjust. Docker Compose reads .env automatically;
# for a local run use: uv run --env-file .env mock-data-gen

# Port the HTTP API listens on (also the published port in Docker).
MOCK_DATA_API_PORT=8000

# Address the API binds to when running locally. Docker Compose always uses 0.0.0.0 inside the container.
MOCK_DATA_API_HOST=127.0.0.1

# URL shown in the UI and in the curl examples. Set it when the API is reached through another host or proxy.
# MOCK_DATA_API_PUBLIC_URL=http://localhost:8000

# Default folder for "Also save to a file". Docker Compose mounts ./output at /data.
MOCK_DATA_OUTPUT_DIR=output

# Docker Compose only: host port for the Streamlit UI.
UI_PORT=8501
